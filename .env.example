# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan commit .env jika berisi konfigurasi privat.

# Tag image GHCR yang dipakai docker-compose.yml.
# Gunakan latest, atau pin ke sha-<commit> / tag versi agar reproducible.
IMAGE_TAG=latest

# Port internal aplikasi Go (nginx tetap menjadi satu-satunya port publik).
PORT=8080

# Daftar slug project, dipisahkan koma. Urutan ini dipakai pada halaman indeks.
# Slug hanya boleh huruf kecil a-z, angka 0-9, dan tanda hubung.
PROJECTS=project-a,project-b

# Setiap slug "project-a" dipetakan ke prefix PROJECT_PROJECT_A_*.
# NAME dan NEW_URL wajib. APP_URL, OLD_DOMAIN, DESCRIPTION, MESSAGE, dan
# ACCENT_COLOR opsional. ACCENT_COLOR hanya menerima format #RGB atau #RRGGBB.

PROJECT_PROJECT_A_NAME=Project A
PROJECT_PROJECT_A_OLD_DOMAIN=old-a.example
PROJECT_PROJECT_A_NEW_URL=https://new-a.example
PROJECT_PROJECT_A_APP_URL=https://downloads.example/app-a
PROJECT_PROJECT_A_DESCRIPTION=Website resmi Project A telah berpindah ke alamat baru.
PROJECT_PROJECT_A_MESSAGE=Gunakan alamat baru untuk mengakses layanan.
PROJECT_PROJECT_A_ACCENT_COLOR=#1d4ed8

PROJECT_PROJECT_B_NAME=Project B
PROJECT_PROJECT_B_OLD_DOMAIN=old-b.example
PROJECT_PROJECT_B_NEW_URL=https://new-b.example
PROJECT_PROJECT_B_APP_URL=
PROJECT_PROJECT_B_DESCRIPTION=Alamat resmi Project B telah diperbarui.
PROJECT_PROJECT_B_MESSAGE=Bookmark alamat baru agar mudah ditemukan.
PROJECT_PROJECT_B_ACCENT_COLOR=#0f766e
